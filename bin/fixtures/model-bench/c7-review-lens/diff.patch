@@ -14,3 +14,20 @@ export function paginate<T>(items: readonly T[], pageSize: number): Page<T>[] {
 export function totalPages(items: readonly unknown[], pageSize: number): number {
   return Math.ceil(items.length / pageSize);
 }
+
+// Resumes pagination from a prior run's checkpoint (`startPage`), for the
+// batch export's retry path — a run that crashed mid-export can restart from
+// where it left off instead of reprocessing already-exported pages.
+export function paginateFrom<T>(
+  items: readonly T[],
+  pageSize: number,
+  startPage: number,
+): Page<T>[] {
+  const pages: Page<T>[] = [];
+  const pageCount = Math.ceil(items.length / pageSize);
+  for (let i = startPage; i <= pageCount; i++) {
+    const start = i * pageSize;
+    pages.push({ items: items.slice(start, start + pageSize), index: i });
+  }
+  return pages;
+}
