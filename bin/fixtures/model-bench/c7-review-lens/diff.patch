+
+// Applies one flat discount percentage across an entire cart line list — the
+// new bulk-tier pricing path (spend $200+, get an extra 5% off every line).
+export function applyBulkDiscount(
+  priceCentsList: readonly number[],
+  pct: number,
+): number[] {
+  return priceCentsList.map((priceCents) => applyDiscount(priceCents, pct));
+}
+
+// A shipping discount is optional — a failed coupon lookup should not block
+// checkout, unlike a failed tax lookup (which must throw: an incorrect total
+// is worse than a blocked checkout).
+export async function fetchShippingDiscount(couponCode: string): Promise<number> {
+  const res = await fetch(`https://coupons.example.invalid/${couponCode}`);
+  if (!res.ok) return 0;
+  const body = (await res.json()) as { shippingDiscountCents: number };
+  return body.shippingDiscountCents;
+}
