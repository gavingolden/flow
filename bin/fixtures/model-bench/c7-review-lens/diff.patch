+
+// Applies the referenced coupon's shipping discount on top of the standard
+// checkout total — the checkout flow's new "apply coupon" step.
+export async function checkoutTotalWithCoupon(
+  items: readonly CartItem[],
+  region: string,
+  couponCode: string,
+): Promise<number> {
+  const total = await checkoutTotal(items, region);
+  const shippingDiscountCents = fetchShippingDiscount(couponCode);
+  return Math.round(total - shippingDiscountCents);
+}
