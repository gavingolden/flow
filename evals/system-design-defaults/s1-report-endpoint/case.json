{
  "id": "s1-report-endpoint",
  "title": "Slow paid work in a request handler: five sequential 20-60 s model calls behind POST /reports (the prompt never says long-running)",
  "provenance": "Synthetic scenario for the system-design-defaults suite: a report endpoint whose aggregate model latency far exceeds the interactive budget. Discovery should choose a durable queue, an idempotency key, timeouts and a cost bound.",
  "prompt": "prompt.md",
  "fixture": {
    "repo": "fixture"
  },
  "graders": [
    {
      "id": "plan-written",
      "kind": "file",
      "file": "$REPO/.flow-tmp/plan.md",
      "exists": true
    },
    {
      "id": "no-agent-fallback",
      "kind": "file",
      "file": "$ASSISTANT_TEXT",
      "notMatches": "NOTICE — agent-fallback:"
    },
    {
      "id": "plugin-loaded",
      "kind": "file",
      "file": "$STREAM",
      "contains": "flow-module-core",
      "withOnly": true
    },
    {
      "id": "queue",
      "kind": "command",
      "argv": [
        "bun",
        "$FIXTURE/../grade-tasks.ts",
        "$REPO/.flow-tmp/plan.md",
        "cloud tasks|pub/?sub|queue|enqueue"
      ],
      "cwd": "$REPO"
    },
    {
      "id": "idempotency",
      "kind": "command",
      "argv": [
        "bun",
        "$FIXTURE/../grade-tasks.ts",
        "$REPO/.flow-tmp/plan.md",
        "idempoten"
      ],
      "cwd": "$REPO"
    },
    {
      "id": "timeout",
      "kind": "command",
      "argv": [
        "bun",
        "$FIXTURE/../grade-tasks.ts",
        "$REPO/.flow-tmp/plan.md",
        "timeout|deadline"
      ],
      "cwd": "$REPO"
    },
    {
      "id": "cost-bound",
      "kind": "command",
      "argv": [
        "bun",
        "$FIXTURE/../grade-tasks.ts",
        "$REPO/.flow-tmp/plan.md",
        "spend|(?<!(?:interactive|time|latency|error|token|retry) )budget|cost (?:cap|bound|limit|ceiling)|ledger"
      ],
      "cwd": "$REPO"
    },
    {
      "id": "result.total_cost_usd",
      "kind": "metric",
      "gate": false,
      "source": "result.total_cost_usd",
      "direction": "lower"
    },
    {
      "id": "result.num_turns",
      "kind": "metric",
      "gate": false,
      "source": "result.num_turns",
      "direction": "lower"
    },
    {
      "id": "result.duration_ms",
      "kind": "metric",
      "gate": false,
      "source": "result.duration_ms",
      "direction": "lower"
    }
  ]
}
