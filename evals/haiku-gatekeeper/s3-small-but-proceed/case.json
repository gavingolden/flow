{
  "id": "s3-small-but-proceed",
  "title": "Gatekeeper proceeds on a small diff whose commit headline doesn't match a trivial-diff pattern",
  "provenance": "PR 204 lifted from bin/fixtures/model-bench/c10-gatekeeper/pr.json; ground truth Ground truth: additions+deletions == 7 (< 10, superficially trivial by size), but the commit headline 'fix: correct off-by-one in retry backoff' matches none of the four trivial-diff patterns, so the AND condition fails; no earlier rule matches (state OPEN, isDraft false) \u2014 falls through to 'otherwise'.",
  "prompt": "prompt.md",
  "fixture": {
    "repo": "fixture",
    "shims": ["../../_shims/gh"]
  },
  "ghCalls": [
    [
      "pr",
      "view",
      "204",
      "--json",
      "state,isDraft,additions,deletions,commits,author,body"
    ]
  ],
  "model": "haiku",
  "resultSchema": "result-schema.json",
  "graders": [
    {
      "id": "decision-matches-truth",
      "kind": "structured",
      "path": "decision",
      "equals": "proceed"
    },
    {
      "id": "no-agent-fallback",
      "kind": "file",
      "file": "$ASSISTANT_TEXT",
      "notMatches": "NOTICE \u2014 agent-fallback:"
    },
    {
      "id": "plugin-loaded",
      "kind": "file",
      "file": "$STREAM",
      "contains": "flow-module-core"
    },
    {
      "id": "gatekeeper-result-decision",
      "kind": "json-file",
      "gate": false,
      "file": "$REPO/.flow-tmp/gatekeeper-result.json",
      "path": "decision",
      "equals": "proceed"
    },
    {
      "id": "gatekeeper-result-exists",
      "kind": "file",
      "gate": false,
      "file": "$REPO/.flow-tmp/gatekeeper-result.json",
      "exists": true
    },
    {
      "id": "transcript.modelShare.haiku",
      "kind": "metric",
      "gate": false,
      "source": "transcript.modelShare.haiku",
      "direction": "higher"
    },
    {
      "id": "result.total_cost_usd",
      "kind": "metric",
      "gate": false,
      "source": "result.total_cost_usd",
      "direction": "lower"
    },
    {
      "id": "result.duration_ms",
      "kind": "metric",
      "gate": false,
      "source": "result.duration_ms",
      "direction": "lower"
    },
    {
      "id": "transcript.subagentsSpawned",
      "kind": "metric",
      "gate": false,
      "source": "transcript.subagentsSpawned",
      "direction": "lower"
    },
    {
      "id": "transcript.finalContextTokens",
      "kind": "metric",
      "gate": false,
      "source": "transcript.finalContextTokens",
      "direction": "lower"
    }
  ]
}
