{
  "id": "s5-open-pr-implementing",
  "title": "Step 5's PR-open tail advances state.phase to implementing",
  "provenance": "Issue #694: the phase-write-fidelity suite covered Steps 7-10's five helper-side advancePhase writes but not Step 5's, the earliest and PHASE_EMITTERS.implementing-mapped one (bin/lib/phase-advance.ts's PHASE_EMITTERS.implementing: \"flow-open-pr\"). This scenario closes that gap the same way s1-s4 cover their steps.",
  "prompt": "prompt.md",
  "fixture": {
    "repo": "fixture",
    "state": "state.json",
    "shims": ["../../_shims/gh"]
  },
  "env": { "flowSlug": true },
  "ghCalls": [["pr", "view", "--json", "number,url"]],
  "resultSchema": "result-schema.json",
  "graders": [
    {
      "id": "state-phase-implementing",
      "kind": "json-file",
      "file": "$STATE",
      "path": "phase",
      "equals": "implementing"
    },
    {
      "id": "state-pr-recorded",
      "kind": "json-file",
      "file": "$STATE",
      "path": "pr",
      "equals": 7
    },
    {
      "id": "no-manual-phase-write",
      "kind": "file",
      "file": "$ASSISTANT_TEXT",
      "notMatches": "flow-state-update[^\\n]*--phase"
    },
    {
      "id": "no-agent-fallback",
      "kind": "file",
      "file": "$ASSISTANT_TEXT",
      "notMatches": "NOTICE — agent-fallback:"
    },
    {
      "id": "plugin-loaded",
      "kind": "file",
      "file": "$STREAM",
      "contains": "flow-module-core"
    },
    {
      "id": "transcript.finalContextTokens",
      "kind": "metric",
      "gate": false,
      "source": "transcript.finalContextTokens",
      "direction": "lower"
    },
    {
      "id": "result.total_cost_usd",
      "kind": "metric",
      "gate": false,
      "source": "result.total_cost_usd",
      "direction": "lower"
    },
    {
      "id": "result.num_turns",
      "kind": "metric",
      "gate": false,
      "source": "result.num_turns",
      "direction": "lower"
    },
    {
      "id": "result.duration_ms",
      "kind": "metric",
      "gate": false,
      "source": "result.duration_ms",
      "direction": "lower"
    },
    {
      "id": "transcript.subagentsSpawned",
      "kind": "metric",
      "gate": false,
      "source": "transcript.subagentsSpawned",
      "direction": "lower"
    }
  ]
}
