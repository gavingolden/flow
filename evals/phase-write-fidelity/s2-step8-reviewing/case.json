{
  "id": "s2-step8-reviewing",
  "title": "Step 8 entry advances state.phase to reviewing",
  "provenance": "Synthetic fixture authored against bin/flow-fetch-pr-review.ts's advancePhase wiring (plan.md Task 4) and skills/pipeline/flow-pipeline/SKILL.md's Step 8. PR record shaped after evals/haiku-gatekeeper/s5-proceed-normal so Step 1.5's gatekeeper reaches 'proceed', not a skip.",
  "prompt": "prompt.md",
  "fixture": {
    "repo": "fixture",
    "state": "state.json",
    "shims": ["../../_shims/gh"]
  },
  "env": { "flowSlug": true },
  "ghCalls": [
    [
      "pr",
      "view",
      "1",
      "--json",
      "state,isDraft,additions,deletions,commits,author,body"
    ],
    [
      "api",
      "repos/{owner}/{repo}/pulls/1",
      "--jq",
      "{title, html_url, number, state, body: (.body // \"\"), additions, deletions, changed_files, head: {ref: .head.ref}}"
    ],
    [
      "api",
      "--paginate",
      "repos/{owner}/{repo}/pulls/1/reviews",
      "--jq",
      ".[] | {body, state, user: {login: .user.login}, html_url}"
    ],
    [
      "api",
      "--paginate",
      "repos/{owner}/{repo}/pulls/1/comments",
      "--jq",
      ".[] | {path, line, start_line, body, diff_hunk, html_url, user: {login: .user.login}, in_reply_to_id, id}"
    ],
    ["pr", "diff", "1", "--name-only"]
  ],
  "resultSchema": "result-schema.json",
  "graders": [
    {
      "id": "state-phase-reviewing",
      "kind": "json-file",
      "file": "$STATE",
      "path": "phase",
      "equals": "reviewing"
    },
    {
      "id": "no-agent-fallback",
      "kind": "file",
      "file": "$ASSISTANT_TEXT",
      "notMatches": "NOTICE — agent-fallback:"
    },
    {
      "id": "plugin-loaded",
      "kind": "file",
      "file": "$STREAM",
      "contains": "flow-module-core"
    },
    {
      "id": "transcript.finalContextTokens",
      "kind": "metric",
      "gate": false,
      "source": "transcript.finalContextTokens",
      "direction": "lower"
    },
    {
      "id": "result.total_cost_usd",
      "kind": "metric",
      "gate": false,
      "source": "result.total_cost_usd",
      "direction": "lower"
    },
    {
      "id": "result.num_turns",
      "kind": "metric",
      "gate": false,
      "source": "result.num_turns",
      "direction": "lower"
    },
    {
      "id": "result.duration_ms",
      "kind": "metric",
      "gate": false,
      "source": "result.duration_ms",
      "direction": "lower"
    },
    {
      "id": "transcript.subagentsSpawned",
      "kind": "metric",
      "gate": false,
      "source": "transcript.subagentsSpawned",
      "direction": "lower"
    }
  ]
}
