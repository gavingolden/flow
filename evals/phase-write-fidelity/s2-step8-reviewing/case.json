{
  "id": "s2-step8-reviewing",
  "title": "Step 8 entry advances state.phase to reviewing",
  "provenance": "Synthetic fixture authored against bin/flow-fetch-pr-review.ts's advancePhase wiring (plan.md Task 4) and skills/pipeline/flow-pipeline/SKILL.md's Step 8. PR record shaped after evals/haiku-gatekeeper/s5-proceed-normal so Step 1.5's gatekeeper reaches 'proceed', not a skip.",
  "prompt": "prompt.md",
  "fixture": {
    "repo": "fixture",
    "state": "state.json",
    "shims": ["../../_shims/gh"]
  },
  "env": { "flowSlug": true },
  "resultSchema": "result-schema.json",
