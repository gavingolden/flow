{
  "id": "s4-step10-merging",
  "title": "Step 10 entry advances state.phase to merging",
  "provenance": "Synthetic fixture authored against bin/flow-merge-guard.ts's advancePhase wiring (plan.md Task 3, corrected call site inside checkGuard, not recordOverrideToken) and skills/pipeline/flow-pipeline/SKILL.md's Step 10. Bumped for Task 10 (issue-tracked f6-workflow-port): re-authored to launch stage B per SKILL.md's Stage B launch section (step 10's flow-merge-guard call moved off stage A), plus the stage-result-written gate grader confirming the workflow actually wrote its result artifact.",
  "prompt": "prompt.md",
  "fixture": {
    "repo": "fixture",
    "state": "state.json",
    "shims": ["../../_shims/gh"]
