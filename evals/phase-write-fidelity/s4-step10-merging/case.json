{
  "id": "s4-step10-merging",
  "title": "Step 10 entry advances state.phase to merging",
  "provenance": "Synthetic fixture authored against bin/flow-merge-guard.ts's merge mode (the standalone `flow-merge-guard merge <pr>` call: live PR view, checks read, advancePhase to merging, then the bare squash merge against the gh shim) and skills/pipeline/flow-pipeline/SKILL.md's Step 10.",
  "prompt": "prompt.md",
  "fixture": {
    "repo": "fixture",
    "state": "state.json",
    "shims": ["../../_shims/gh"]
  },
  "env": {
    "flowSlug": true
  },
  "ghCalls": [
    ["pr", "view", "1", "--json", "body,state,url"],
    ["pr", "checks", "1", "--json", "name,state"],
    ["pr", "merge", "--squash", "1"]
  ],
  "resultSchema": "result-schema.json",
  "graders": [
    {
      "id": "state-phase-merging",
      "kind": "json-file",
      "file": "$STATE",
      "path": "phase",
      "equals": "merging"
    },
    {
      "id": "no-agent-fallback",
      "kind": "file",
      "file": "$ASSISTANT_TEXT",
      "notMatches": "NOTICE — agent-fallback:"
    },
    {
      "id": "plugin-loaded",
      "kind": "file",
      "file": "$STREAM",
      "contains": "flow-module-core",
      "withOnly": true
    },
    {
      "id": "step-doc-opened",
      "kind": "command",
      "gate": false,
      "argv": [
        "jq",
        "-e",
        "-s",
        "any(.[]; .type==\"assistant\" and any(.message.content[]?; .type==\"tool_use\" and .name==\"Read\" and ((.input.file_path // \"\") | test(\"references/phases/step-10-merge\\\\.md\"))))",
        "$STREAM"
      ]
    },
    {
      "id": "transcript.finalContextTokens",
      "kind": "metric",
      "gate": false,
      "source": "transcript.finalContextTokens",
      "direction": "lower"
    },
    {
      "id": "result.total_cost_usd",
      "kind": "metric",
      "gate": false,
      "source": "result.total_cost_usd",
      "direction": "lower"
    },
    {
      "id": "result.num_turns",
      "kind": "metric",
      "gate": false,
      "source": "result.num_turns",
      "direction": "lower"
    },
    {
      "id": "result.duration_ms",
      "kind": "metric",
      "gate": false,
      "source": "result.duration_ms",
      "direction": "lower"
    },
    {
      "id": "transcript.subagentsSpawned",
      "kind": "metric",
      "gate": false,
      "source": "transcript.subagentsSpawned",
      "direction": "lower"
    }
  ]
}
