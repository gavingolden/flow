{
  "id": "s1-step7-ci-wait",
  "title": "Step 7 entry advances state.phase to ci-wait",
  "provenance": "Synthetic fixture authored against bin/flow-ci-check.ts's advancePhase wiring (plan.md Task 2) and skills/pipeline/flow-pipeline/SKILL.md's Step 7 — the four phases (ci-wait/reviewing/gating/merging) this suite measures had no eval coverage before this PR (issue #679).",
  "prompt": "prompt.md",
  "fixture": {
    "repo": "fixture",
    "state": "state.json",
    "shims": ["../../_shims/gh"]
  },
  "env": { "flowSlug": true },
  "ghCalls": [
    ["pr", "view", "1", "--json", "state,url,reviews,headRefOid"],
    ["pr", "view", "1", "--json", "mergeable,mergeStateStatus"]
  ],
  "resultSchema": "result-schema.json",
  "graders": [
    {
      "id": "state-phase-ci-wait",
      "kind": "json-file",
      "file": "$STATE",
      "path": "phase",
      "equals": "ci-wait"
    },
    {
      "id": "no-agent-fallback",
      "kind": "file",
      "file": "$ASSISTANT_TEXT",
      "notMatches": "NOTICE — agent-fallback:"
    },
    {
      "id": "plugin-loaded",
      "kind": "file",
      "file": "$STREAM",
      "contains": "flow-module-core"
    },
    {
      "id": "transcript.finalContextTokens",
      "kind": "metric",
      "gate": false,
      "source": "transcript.finalContextTokens",
      "direction": "lower"
    },
    {
      "id": "result.total_cost_usd",
      "kind": "metric",
      "gate": false,
      "source": "result.total_cost_usd",
      "direction": "lower"
    },
    {
      "id": "result.num_turns",
      "kind": "metric",
      "gate": false,
      "source": "result.num_turns",
      "direction": "lower"
    },
    {
      "id": "result.duration_ms",
      "kind": "metric",
      "gate": false,
      "source": "result.duration_ms",
      "direction": "lower"
    },
    {
      "id": "transcript.subagentsSpawned",
      "kind": "metric",
      "gate": false,
      "source": "transcript.subagentsSpawned",
      "direction": "lower"
    }
  ]
}
