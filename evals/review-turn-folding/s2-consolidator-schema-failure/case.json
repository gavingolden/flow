      "file": "$REPO/.flow-tmp/pr-review-result.json",
      "path": "status",
      "equals": "escalated"
    },
    {
      "id": "result-escalation-tag",
      "kind": "json-file",
      "file": "$REPO/.flow-tmp/pr-review-result.json",
      "path": "escalation_tag",
      "equals": "consolidator-schema-failure"
    },
    {
      "id": "plugin-loaded",
      "kind": "file",
      "file": "$STREAM",
      "contains": "flow-module-core",
      "withOnly": true
    },
    {
      "id": "result.num_turns",
      "kind": "metric",
      "gate": false,
