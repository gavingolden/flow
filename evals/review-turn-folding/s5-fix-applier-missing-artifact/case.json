{
  "id": "s5-fix-applier-missing-artifact",
  "title": "Missing fix-applier artifact escalates",
  "provenance": "Synthetic fixture authored for issue #835's turn-folding measurement: pre-written .flow-tmp artifacts (valid per bin/lib/agent-finding-schema.ts and bin/lib/fix-applier-schema.ts unless the scenario says otherwise) stand in for what the named agent wrote, and the prompt bounds the run to the post-return handling at skills/pipeline/flow-pr-review/SKILL.md. Run against the unchanged skills to record the before arm. No fix-applier-result.json is seeded, so the completeness check must fail.",
  "prompt": "prompt.md",
  "fixture": {
    "repo": "fixture",
    "state": "state.json",
    "shims": ["../../_shims/gh"]
  },
  "env": {
    "flowSlug": true
  },
  "ghCalls": [
    [
      "pr",
      "view",
      "1",
      "--json",
      "state,isDraft,additions,deletions,commits,author,body"
    ],
    [
      "api",
      "repos/{owner}/{repo}/pulls/1",
      "--jq",
      "{title, html_url, number, state, body: (.body // \"\"), additions, deletions, changed_files, head: {ref: .head.ref}}"
    ],
    [
      "api",
      "--paginate",
      "repos/{owner}/{repo}/pulls/1/reviews",
      "--jq",
      ".[] | {body, state, user: {login: .user.login}, html_url}"
    ],
    [
      "api",
      "--paginate",
      "repos/{owner}/{repo}/pulls/1/comments",
      "--jq",
      ".[] | {path, line, start_line, body, diff_hunk, html_url, user: {login: .user.login}, in_reply_to_id, id}"
    ],
    ["pr", "diff", "1", "--name-only"]
  ],
  "resultSchema": "result-schema.json",
  "graders": [
    {
      "id": "escalation-tag",
      "kind": "structured",
      "path": "escalation_tag",
      "equals": "fix-applier-missing-artifact"
    },
    {
      "id": "result-status-escalated",
      "kind": "json-file",
      "file": "$REPO/.flow-tmp/pr-review-result.json",
      "path": "status",
      "equals": "escalated"
    },
    {
      "id": "result-escalation-tag",
      "kind": "json-file",
      "file": "$REPO/.flow-tmp/pr-review-result.json",
      "path": "escalation_tag",
      "equals": "fix-applier-missing-artifact"
    },
    {
      "id": "plugin-loaded",
      "kind": "file",
      "file": "$STREAM",
      "contains": "flow-module-core",
      "withOnly": true
    },
    {
      "id": "result.num_turns",
      "kind": "metric",
      "gate": false,
      "source": "result.num_turns",
      "direction": "lower"
    },
    {
      "id": "result.total_cost_usd",
      "kind": "metric",
      "gate": false,
      "source": "result.total_cost_usd",
      "direction": "lower"
    },
    {
      "id": "transcript.finalContextTokens",
      "kind": "metric",
      "gate": false,
      "source": "transcript.finalContextTokens",
      "direction": "lower"
    },
    {
      "id": "transcript.toolCalls.Bash",
      "kind": "metric",
      "gate": false,
      "source": "transcript.toolCalls.Bash",
      "direction": "lower"
    },
    {
      "id": "transcript.subagentsSpawned",
      "kind": "metric",
      "gate": false,
      "source": "transcript.subagentsSpawned",
      "direction": "lower"
    }
  ]
}
