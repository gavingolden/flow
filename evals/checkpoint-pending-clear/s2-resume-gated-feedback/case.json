{
  "id": "s2-resume-gated-feedback",
  "title": "Resume re-enters gated-feedback mode and carries the cleared manual Test Step",
  "provenance": "Synthetic fixture authored against bin/flow-resume-decide.ts's gated-feedback branch (worktree present AND checkpoint marker AND PR OPEN) and bin/flow-checkpoint.ts's arm/consume contract. ghCalls is a best-effort declaration — this scenario's gh path is model-determined via promptSeed 'resume'; the declared argv mirrors bin/lib/resume-probes.ts's probePr(branch, gh) call (gh([\"pr\", \"view\", branch, \"--json\", \"number,state,url\"])) that flow-resume-decide invokes on the eval-materialized branch, not an observed transcript.",
  "prompt": "prompt.md",
  "promptSeed": "resume",
  "fixture": {
    "repo": "fixture",
    "state": "state.json",
    "checkpoint": { "body": "checkpoint.md", "site": "gate", "armed": true },
    "shims": ["../../_shims/gh"]
  },
  "env": { "flowSlug": true },
  "ghCalls": [["pr", "view", "eval", "--json", "number,state,url"]],
  "resultSchema": "result-schema.json",
  "graders": [
    {
      "id": "resumed-step-null-on-gated-feedback",
      "kind": "structured",
      "path": "resumed_step",
      "equals": null
    },
    {
      "id": "action-matches-resume",
      "kind": "structured",
      "gate": false,
      "path": "action",
      "equals": "resume"
    },
    {
      "id": "cleared-items-carries-test-step-2",
      "kind": "structured",
      "path": "cleared_items",
      "contains": "Test Step 2"
    },
    {
      "id": "state-phase-still-gated",
      "kind": "json-file",
      "file": "$STATE",
      "path": "phase",
      "equals": "gated"
    },
    {
      "id": "no-agent-fallback",
      "kind": "file",
      "file": "$ASSISTANT_TEXT",
      "notMatches": "NOTICE — agent-fallback:"
    },
    {
      "id": "plugin-loaded",
      "kind": "file",
      "file": "$STREAM",
      "contains": "flow-module-core"
    },
    {
      "id": "transcript.finalContextTokens",
      "kind": "metric",
      "gate": false,
      "source": "transcript.finalContextTokens",
      "direction": "lower"
    },
    {
      "id": "result.total_cost_usd",
      "kind": "metric",
      "gate": false,
      "source": "result.total_cost_usd",
      "direction": "lower"
    },
    {
      "id": "result.num_turns",
      "kind": "metric",
      "gate": false,
      "source": "result.num_turns",
      "direction": "lower"
    },
    {
      "id": "result.duration_ms",
      "kind": "metric",
      "gate": false,
      "source": "result.duration_ms",
      "direction": "lower"
    }
  ]
}
